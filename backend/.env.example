# Django
SECRET_KEY=change-me-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=logistika
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis / Celery / Channels
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
MATCHING_OFFERS_ASYNC=true

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=https://app.example.com

# Payments
PAYMENTS_ALLOW_MOCK=False
ORDER_PLATFORM_PAYMENTS_ENABLED=False
PLATFORM_COMMISSION_PERCENT=10
CANCELLATION_FEE_CLIENT_BEFORE_START_PERCENT=0
CANCELLATION_FEE_CLIENT_AFTER_START_PERCENT=20
CANCELLATION_FEE_DRIVER_AFTER_START_PERCENT=10
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_ALLOWED_IPS=
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_SECRET_KEY=
PAYME_ALLOWED_IPS=
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=
UZUM_ALLOWED_IPS=

# SMS (Eskiz)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
SMS_VERIFICATION_REQUIRED=False

# Maps / routing
GOOGLE_MAPS_API_KEY=
YANDEX_ROUTING_API_KEY=

# Push (FCM legacy)
FCM_SERVER_KEY=

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
STRUCTURED_LOGS=True

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Subscriptions
SUBSCRIPTIONS_ENFORCED=False
SUBSCRIPTION_FREE_TRIAL_USES=3

# Media storage (optional S3 — leave empty for local disk)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=
# Serve /media/ from Django when DEBUG=False and S3 is not configured (docker-compose default)
SERVE_LOCAL_MEDIA=True
